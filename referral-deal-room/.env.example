# ---------------------------------------------------------------------------
# Referral Deal Room — environment variables
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Database: Neon Postgres ----------------------------------------------
# Use the *pooled* connection string for the app, and add ?sslmode=require.
# Get this from the Neon console → Connection Details.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Optional direct (non-pooled) URL used by migrations / drizzle-kit.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Auth: Clerk (organization support enabled) ---------------------------
# Clerk dashboard → API Keys. Enable Organizations in the Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
# Webhook signing secret (Clerk dashboard → Webhooks) — used to sync
# orgs/users into our DB.
CLERK_WEBHOOK_SIGNING_SECRET="whsec_xxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# --- Background jobs: Inngest ---------------------------------------------
# From the Inngest dashboard. For local dev the CLI dev server needs none.
INNGEST_EVENT_KEY="xxx"
INNGEST_SIGNING_KEY="signkey-xxx"

# --- Email: Resend --------------------------------------------------------
RESEND_API_KEY="re_xxx"
EMAIL_FROM="Deal Room <notifications@yourdomain.com>"

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
